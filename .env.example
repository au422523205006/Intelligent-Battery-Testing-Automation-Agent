# ==============================================================================
# EV Battery Monitoring Agent - Environment Configuration
# ==============================================================================

# LLM Provider Configuration & Priority:
# Default Priority: 1. Groq -> 2. OpenRouter -> 3. Gemini -> 4. Ollama
PRIMARY_LLM=groq
LLM_FALLBACK_ORDER=groq,openrouter,gemini,ollama
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2

# 1. Groq (Primary): Sign up at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# 2. OpenRouter (Second): Sign up at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# 3. Google Gemini (Third): Sign up at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# 4. Ollama (Optional Local Offline LLM): Download from https://ollama.ai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=tinyllama:latest
